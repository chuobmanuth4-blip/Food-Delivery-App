	<queryString language="SQL">
		<![CDATA[SELECT Orders.OrderNo,Orders.Dates,Orders.CustNo,Orders.EmpNo,Orders.Location,Orders.Status,
Details.ProNo,Products.ProName,Details.Qty,Details.UP, Details.Qty*Details.UP as Total
from Orders inner join Details
on Orders.OrderNo=Details.OrderNo inner join Products
on Details.ProNo=Products.ProNo
where Details.OrderNo=301]]>
	</queryString>
