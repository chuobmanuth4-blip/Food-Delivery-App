<jasperReport name="DeliveryReceipt" language="java" columnCount="1" pageWidth="600" pageHeight="600" columnWidth="570" leftMargin="15" rightMargin="15" topMargin="10" bottomMargin="10" uuid="2f803344-7631-4c4e-b60d-50dd9a5058ef" ignorePagination="true" floatColumnFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MYSQL"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="OrderNoParam" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT
    o.OrderNo,
    o.OrderDate,
    o.DeliveryID AS DeliverymanID,
    c.Username AS CustomerName,
    o.Address,
    o.Phone AS Telephone,
    p.ProNo,
    p.ProName,
    d.Quantity,
    d.Price,
    (d.Quantity * d.Price) AS Total
FROM Orders o
INNER JOIN Details d
    ON o.OrderNo = d.OrderNo
INNER JOIN Products p
    ON d.ProNo = p.ProNo
INNER JOIN Users c
    ON o.CustomerID = c.UserID
LEFT JOIN Users dm
    ON o.DeliveryID = dm.UserID
    WHERE o.OrderNo = $P{OrderNoParam}
ORDER BY o.OrderNo
]]></query>
